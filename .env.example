# ========================================
# Central Backend
# ========================================
REACT_APP_CENTRAL_API_URL=http://localhost:5001/api

# Temporary legacy alias. Prefer REACT_APP_CENTRAL_API_URL.
# REACT_APP_API_URL=http://localhost:5001/api

# ========================================
# Local POS Service
# ========================================
REACT_APP_POS_LOCAL_API_ENABLED=true
REACT_APP_POS_LOCAL_API_URL=http://127.0.0.1:4782/api/v1

# Development only. Production packaging must obtain this through
# window.shajPosBridge.getLocalApiToken().
REACT_APP_POS_LOCAL_API_TOKEN=

# ========================================
# Optional Frontend Runtime
# ========================================
REACT_APP_PRINT_SERVICE_URL=http://localhost:5000
REACT_APP_HEALTHCHECK_ENABLED=true
REACT_APP_HEALTHCHECK_INTERVAL_MS=240000
REACT_APP_FOR_RESUME=false
REACT_APP_RESUME_EMAIL=
REACT_APP_RESUME_PASSWORD=
TOKEN_EXPIRY=54000
GENERATE_SOURCEMAP=false

# ========================================
# Cypress
# ========================================
CYPRESS_EMAIL=cypress@test.com
CYPRESS_PASSWORD=cypress
CYPRESS_API_URL=http://localhost:5001/api
CYPRESS_BASE_URL=http://localhost:3000
